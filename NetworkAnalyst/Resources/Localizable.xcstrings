    "traceroute.geoip_disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, router IP addresses will be queried via an external HTTPS GeoIP API (ipinfo.io). Disabled by default for privacy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bật, địa chỉ IP của mỗi hop sẽ được gửi qua HTTPS tới dịch vụ ngoài (ipinfo.io) để lấy vị trí. Mặc định tắt nhằm bảo vệ quyền riêng tư."
          }
        }
      }
    },
