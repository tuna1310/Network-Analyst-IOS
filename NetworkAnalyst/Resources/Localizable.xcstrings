    "traceroute.darwin_limitation_notice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If intermediate hops show * * *, this is a known iOS/Darwin kernel security restriction where unprivileged sockets do not receive ICMP Type 11. Verification on physical device required."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu các hop trung gian hiển thị * * *, đây là giới hạn bảo mật đã biết của nhân iOS/Darwin đối với socket không đặc quyền (không chuyển giao ICMP Type 11). Cần kiểm chứng trên thiết bị iPhone thật."
          }
        }
      }
    },
